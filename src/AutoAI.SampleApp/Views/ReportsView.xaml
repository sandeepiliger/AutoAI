<UserControl x:Class="AutoAI.SampleApp.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Reports" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />

        <!-- Report catalog -->
        <TreeView Grid.Row="1" Grid.Column="0"
                  x:Name="ReportsTreeView"
                  AutomationProperties.AutomationId="ReportsTreeView"
                  SelectedItemChanged="ReportsTreeView_SelectedItemChanged">
            <TreeViewItem Header="Sales" AutomationProperties.AutomationId="SalesTreeItem">
                <TreeViewItem Header="Q1 Sales" AutomationProperties.AutomationId="SalesQ1TreeItem" />
                <TreeViewItem Header="Q2 Sales" AutomationProperties.AutomationId="SalesQ2TreeItem" />
                <TreeViewItem Header="Annual Summary" AutomationProperties.AutomationId="SalesAnnualTreeItem" />
            </TreeViewItem>
            <TreeViewItem Header="Inventory" AutomationProperties.AutomationId="InventoryTreeItem">
                <TreeViewItem Header="Stock Levels" AutomationProperties.AutomationId="InventoryStockTreeItem" />
                <TreeViewItem Header="Reorder Report" AutomationProperties.AutomationId="InventoryReorderTreeItem" />
            </TreeViewItem>
            <TreeViewItem Header="Finance" AutomationProperties.AutomationId="FinanceTreeItem">
                <TreeViewItem Header="Profit and Loss" AutomationProperties.AutomationId="FinancePnlTreeItem" />
                <TreeViewItem Header="Balance Sheet" AutomationProperties.AutomationId="FinanceBalanceTreeItem" />
            </TreeViewItem>
        </TreeView>

        <!-- Report generation -->
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="16,0,0,0">
            <TextBlock x:Name="ReportsSelectedText"
                       AutomationProperties.AutomationId="ReportsSelectedText"
                       Text="No report selected" FontWeight="SemiBold" />

            <Expander x:Name="ReportsOptionsExpander"
                      AutomationProperties.AutomationId="ReportsOptionsExpander"
                      Header="Report options" Margin="0,8,0,0">
                <StackPanel Margin="16,4,0,4">
                    <CheckBox x:Name="ReportsIncludeChartsCheckBox"
                              AutomationProperties.AutomationId="ReportsIncludeChartsCheckBox"
                              Content="Include charts" Margin="0,2" />
                    <CheckBox x:Name="ReportsDetailedCheckBox"
                              AutomationProperties.AutomationId="ReportsDetailedCheckBox"
                              Content="Detailed breakdown" Margin="0,2" />
                </StackPanel>
            </Expander>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="ReportsGenerateButton"
                        AutomationProperties.AutomationId="ReportsGenerateButton"
                        Content="Generate Report" Width="130" Height="30"
                        Click="ReportsGenerateButton_Click" />
                <TextBlock x:Name="ReportsStatusText"
                           AutomationProperties.AutomationId="ReportsStatusText"
                           Text="Idle" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <ProgressBar x:Name="ReportsProgressBar"
                         AutomationProperties.AutomationId="ReportsProgressBar"
                         Minimum="0" Maximum="100" Height="16" Margin="0,10,0,0" />

            <ListBox x:Name="ReportsResultList"
                     AutomationProperties.AutomationId="ReportsResultList"
                     Height="220" Margin="0,12,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
