<Window x:Class="AutoAI.SampleApp.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        AutomationProperties.AutomationId="SettingsDialog"
        Height="300" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Theme:" Margin="0,0,0,4" />
        <ComboBox x:Name="SettingsThemeComboBox"
                  AutomationProperties.AutomationId="SettingsThemeComboBox"
                  Width="200" Height="28" HorizontalAlignment="Left"
                  SelectedIndex="0">
            <ComboBoxItem Content="Light" />
            <ComboBoxItem Content="Dark" />
            <ComboBoxItem Content="System" />
        </ComboBox>

        <CheckBox x:Name="SettingsAutoRefreshCheckBox"
                  AutomationProperties.AutomationId="SettingsAutoRefreshCheckBox"
                  Content="Auto refresh data" Margin="0,12,0,0" IsChecked="True" />

        <TextBlock Text="API key:" Margin="0,12,0,4" />
        <PasswordBox x:Name="SettingsApiKeyPasswordBox"
                     AutomationProperties.AutomationId="SettingsApiKeyPasswordBox"
                     Width="280" Height="28" HorizontalAlignment="Left" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="SettingsSaveButton"
                    AutomationProperties.AutomationId="SettingsSaveButton"
                    Content="Save" Width="80" Height="28" IsDefault="True"
                    Click="SettingsSaveButton_Click" />
            <Button x:Name="SettingsCancelButton"
                    AutomationProperties.AutomationId="SettingsCancelButton"
                    Content="Cancel" Width="80" Height="28" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
