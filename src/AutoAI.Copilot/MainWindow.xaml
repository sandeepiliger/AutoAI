<Window x:Class="AutoAI.Copilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:AutoAI.Copilot.Behaviors"
        Title="AutoAI Test Copilot"
        Height="700" Width="780"
        MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- User message: right-aligned gradient bubble -->
        <DataTemplate x:Key="UserBubbleTemplate">
            <StackPanel HorizontalAlignment="Right" Margin="80,4,0,4">
                <Border Background="{StaticResource AccentGradientBrush}"
                        CornerRadius="14,14,4,14" Padding="13,9" MaxWidth="520">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                               Foreground="White" FontSize="13" LineHeight="19" />
                </Border>
                <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm}"
                           FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Right" Margin="0,3,4,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Assistant message: avatar + card bubble -->
        <DataTemplate x:Key="AssistantBubbleTemplate">
            <Grid Margin="0,4,80,4" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                        Background="{StaticResource AccentGradientBrush}"
                        VerticalAlignment="Top" Margin="0,2,8,0">
                    <TextBlock Text="&#x1F916;" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <Border Background="{StaticResource CardBrush}"
                            CornerRadius="4,14,14,14" Padding="13,9" MaxWidth="520"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" LineHeight="19" />
                    </Border>
                    <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm}"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                               Margin="4,3,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Tool call: compact monospace row -->
        <DataTemplate x:Key="ToolCallTemplate">
            <Grid Margin="36,2,40,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE90F;" FontFamily="{StaticResource IconFont}"
                           FontSize="11" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Top" Margin="0,3,7,0" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>
        </DataTemplate>

        <!-- Tool result: compact monospace row, success-tinted glyph -->
        <DataTemplate x:Key="ToolResultTemplate">
            <Grid Margin="36,2,40,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE72A;" FontFamily="{StaticResource IconFont}"
                           FontSize="11" Foreground="{StaticResource SuccessBrush}"
                           VerticalAlignment="Top" Margin="0,3,7,0" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" />
            </Grid>
        </DataTemplate>

        <!-- Error: red-tinted card -->
        <DataTemplate x:Key="ErrorTemplate">
            <Border Background="{StaticResource ErrorBgBrush}" CornerRadius="10"
                    Padding="12,9" Margin="36,4,40,4" HorizontalAlignment="Left" MaxWidth="560">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}"
                               FontSize="12" Foreground="{StaticResource ErrorBrush}"
                               VerticalAlignment="Top" Margin="0,2,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                               FontSize="12" Foreground="{StaticResource ErrorBrush}" />
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <!-- Compensate for the resize border when maximized -->
    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="Padding" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8"
                            Background="{StaticResource AccentGradientBrush}">
                        <TextBlock Text="&#x1F916;" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="AutoAI Test Copilot" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" />

                    <!-- Status pill -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                            Padding="9,4" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="PulseStoryboard">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1" To="0.25" Duration="0:0:0.6" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;"
                            Click="TitleBarMinimizeButton_Click" />
                    <Button Style="{StaticResource TitleBarButton}"
                            Click="TitleBarMaximizeButton_Click">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE922;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                            <Setter Property="Text" Value="&#xE923;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;"
                            Click="TitleBarCloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- ===== Conversation ===== -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="20,8"
                          behaviors:AutoScrollBehavior.AutoScroll="True">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                </ScrollViewer.Resources>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" Focusable="False">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource AssistantBubbleTemplate}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="User">
                                                <Setter Property="ContentTemplate" Value="{StaticResource UserBubbleTemplate}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="ToolCall">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ToolCallTemplate}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="ToolResult">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ToolResultTemplate}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ErrorTemplate}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ===== Input bar ===== -->
            <Grid Grid.Row="2" Margin="16,8,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource ModernButton}"
                        Command="{Binding LaunchAppCommand}"
                        ToolTip="Launch the app under test"
                        Margin="0,0,10,0" Padding="13,0" VerticalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                   FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Launch App" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Grid.Column="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="InputBox"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource TextPrimaryBrush}"
                                 SelectionBrush="{StaticResource AccentBrush}"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"
                                 Padding="8,6"
                                 MaxHeight="120"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <TextBlock Grid.Column="0"
                                   Text="Describe a test... e.g. &quot;Go to Orders, load them and verify 10 rows&quot;"
                                   FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InputText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Grid.Column="1"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding SendCommand}"
                                ToolTip="Send (Enter)"
                                Width="38" Height="38" Padding="0"
                                VerticalAlignment="Bottom">
                            <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
