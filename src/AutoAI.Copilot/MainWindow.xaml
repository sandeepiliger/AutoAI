<Window x:Class="AutoAI.Copilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:AutoAI.Copilot.Behaviors"
        xmlns:vm="clr-namespace:AutoAI.Copilot.ViewModels"
        Title="AutoAI Test Copilot"
        Height="640" Width="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Conversation -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      behaviors:AutoScrollBehavior.AutoScroll="True">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChatItemViewModel}">
                        <Border x:Name="Bubble"
                                CornerRadius="8" Padding="10,6" Margin="0,3"
                                MaxWidth="540" HorizontalAlignment="Left"
                                Background="#FFF0F0F0">
                            <TextBlock x:Name="MessageText"
                                       Text="{Binding Text}"
                                       TextWrapping="Wrap" />
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="User">
                                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Bubble" Property="Background" Value="#FF1F6FEB" />
                                <Setter TargetName="MessageText" Property="Foreground" Value="White" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="ToolCall">
                                <Setter TargetName="Bubble" Property="Background" Value="Transparent" />
                                <Setter TargetName="MessageText" Property="FontFamily" Value="Consolas" />
                                <Setter TargetName="MessageText" Property="FontSize" Value="11" />
                                <Setter TargetName="MessageText" Property="Foreground" Value="#FF707070" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="ToolResult">
                                <Setter TargetName="Bubble" Property="Background" Value="Transparent" />
                                <Setter TargetName="MessageText" Property="FontFamily" Value="Consolas" />
                                <Setter TargetName="MessageText" Property="FontSize" Value="11" />
                                <Setter TargetName="MessageText" Property="Foreground" Value="#FF4A8A4A" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Error">
                                <Setter TargetName="Bubble" Property="Background" Value="#FFFBEAEA" />
                                <Setter TargetName="MessageText" Property="Foreground" Value="#FFB00020" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input row -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     Height="32" VerticalContentAlignment="Center">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SendCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Send" Width="80" Height="32" Margin="8,0,0,0"
                    Command="{Binding SendCommand}" />
            <Button Grid.Column="2" Content="Launch App" Width="100" Height="32" Margin="8,0,0,0"
                    Command="{Binding LaunchAppCommand}" />
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="2" Margin="2,6,0,0"
                   Text="{Binding StatusText}"
                   Foreground="#FF808080" FontSize="11" />
    </Grid>
</Window>
